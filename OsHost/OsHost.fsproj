<Project Sdk="Microsoft.NET.Sdk">

  <!--
    操作系统层（netstandard2.0）：STA 线程、进程账本、窗口 → 进程号、时间、文件时间、COM 底层，
    以及「常驻进程」的地址格式（Address.fs）和起 / 关两条通用命令（ProcHost.fs）。
    三家 host 库都引它 —— 这些活儿三家一模一样，只该有一份。
    不认 Office 类型，所以也不需要任何互操作程序集：只认句柄、进程号和 IUnknown。
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>OsHost</AssemblyName>
    <RootNamespace>OsHost</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="OsHost.fs" />
    <!-- 黑板模式：与种类完全解耦的通用参数表，身份用参数、取对象用注入函数占位 -->
    <!-- 旧路 AppKind / AppInfo 已按用户决定删除（2026-11-07 14:11），四家身份常量搬进各自 Host -->
    <Compile Include="GeneralAppInfo.fs" />
    <Compile Include="Address.fs" />
    <Compile Include="ProcHost.fs" />
    <!-- 读文本：BOM 优先 + 无 BOM 的 UTF-8/GBK/ASCII 歧义判定；短名称注册也在这一份 -->
    <Compile Include="TextFile.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.403" />
    <!-- GBK(936) 在 .NET Core / .NET 5+ 上要靠代码页 provider 才取得到 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
  </ItemGroup>

</Project>

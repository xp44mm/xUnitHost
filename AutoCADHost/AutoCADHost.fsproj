<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>netstandard2.0</TargetFramework>
        <AssemblyName>AutoCADHost</AssemblyName>
        <RootNamespace>AutoCADHost</RootNamespace>
        <LangVersion>latest</LangVersion>
        <PlatformTarget>x64</PlatformTarget>
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="EventPair.fs" />
        <Compile Include="AcadBeginEnd.fs" />
        <Compile Include="Application.fs" />
        <Compile Include="AutoCADTask.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OsHost\OsHost.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Autodesk.AutoCAD.Interop">
            <HintPath>C:\Program Files\Autodesk\AutoCAD 2020\Autodesk.AutoCAD.Interop.dll</HintPath>
            <EmbedInteropTypes>false</EmbedInteropTypes>
            <Private>true</Private>
        </Reference>
        <Reference Include="Autodesk.AutoCAD.Interop.Common">
            <HintPath>C:\Program Files\Autodesk\AutoCAD 2020\Autodesk.AutoCAD.Interop.Common.dll</HintPath>
            <EmbedInteropTypes>false</EmbedInteropTypes>
            <Private>true</Private>
        </Reference>
        
        <PackageReference Update="FSharp.Core" Version="11.0.101" />
        
    </ItemGroup>


</Project>

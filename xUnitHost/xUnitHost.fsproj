<Project Sdk="Microsoft.NET.Sdk">

  <!--
    测试项目。编译顺序就是读的顺序：
      前部：Common.fs（报告 / 认人 / 忙重试）→ Session.fs（会话层：地址、指纹、两种方式）
            → ConvertCore.fs（测试项目这侧：Item / Outcome / Paths）
            → Convert.fs（只做分派、批量、事后核对）
      四条转换住在各自 host 库的末尾，两侧对称：WordHost/DocIO.fs + DocUpgrade.fs、
            ExcelHost/BookIO.fs + XlsUpgrade.fs（各一份文件放两条转换 + 一个判宏选路的统一入口）
      后面：各个 Fact。第二个进程就是它自己再起一份（SecondProcessTest.fs），没有别的程序。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- AutoCAD 的互操作程序集只有 64 位版本 -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 公用在最前，测试在后 -->
    <Compile Include="Common.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="ConvertCore.fs" />
    <Compile Include="Convert.fs" />
    <!-- 黑板模式：参考解析（展示文本 → BoardApp / BoardDoc，只供调用方参考）+ 挂回验证 -->
    <Compile Include="BlackboardText.fs" />
    <Compile Include="BlackboardTest.fs" />
    <!-- ROT 的两个方向（注册名 ↔ 进程号）：离线，只登记一条自己的条目 -->
    <Compile Include="RotTest.fs" />
    <!-- OsHost.Sta：固定 STA 线程的单例语义（同一线程 / 先进先出 / 自等报错 / 关停），离线 -->
    <Compile Include="StaThreadTest.fs" />
    <Compile Include="HostGreetingTest.fs" />
    <Compile Include="SecondProcessTest.fs" />
    <Compile Include="CollaborationTest.fs" />
    <Compile Include="ConvertTest.fs" />
    <!-- 常驻 Excel 挂回式通道：排在 ConvertTest.fs 之后，复用 RealFolder -->
    <Compile Include="AttachedConvertTest.fs" />
    <!-- 烟气参数：黑板挂回现成 Excel，把「名称，单位」拆成 B/C 两列 -->
    <Compile Include="GasParamTest.fs" />
    <!-- 焦炉煤气：按「选设备稍有裕量」把 D 列区间定成 E 列设计值 -->
    <Compile Include="GasDesignTest.fs" />
    <!-- 被加热烟气成分：燃烧计量 → A13 起写组分 vol.%（焓值输入） -->
    <Compile Include="GasFlueTest.fs" />
    <!-- 烟气吸热量：参考「体积法scr烟气吸热」，A3 起复刻体积法计算链 -->
    <Compile Include="GasHeatTest.fs" />
    <!-- 公式写法对比：Range.Formula 自动补 @，Range.Formula2 原样存（临时工作簿，测完即关） -->
    <Compile Include="ExcelFormula2Test.fs" />
    <!-- 补热燃烧计算：参考 煤气燃烧计算.xlsx，另存 补热焦炉煤气燃烧计算书.xlsx -->
    <Compile Include="GasCombustionTest.fs" />
    <!-- 被加热烟气成分：由含氧量反算 α，只算成分（不写焓值与放热量） -->
    <Compile Include="GasCompositionTest.fs" />
    <!-- 补热燃烧去二分：放热量改回 LHV − 产物显热，删掉 T_ad 反解与 F:L 二分表（改用户真表） -->
    <Compile Include="GasAdiabaticTrimTest.fs" />
    <!-- 燃烧器选型：按燃料类型把不同口径的选型计算一起开进用户那只 Excel（只开不关） -->
    <Compile Include="BurnerCatalogTest.fs" />
    <!-- 燃烧器选型表：参照「天然气燃烧器」骨架，在补燃计算书里新建「燃烧器选型」并接到补热表 -->
    <Compile Include="BurnerSelectTest.fs" />
    <!-- P0 安全开关：不弹修复框、不启用宏、按类型分三轮 -->
    <Compile Include="ConvertSafetyTest.fs" />
    <Compile Include="DnTest.fs" />
    <Compile Include="PriceTest.fs" />
    <Compile Include="DocSyncTest.fs" />
    <!-- 山西太钢技术协议：挂回正开着的 Word，只读读出燃烧器的燃料量 / 助燃风量 -->
    <Compile Include="TaigangProtocolTest.fs" />
    <Compile Include="PptUpgradeTest.fs" />
    <!-- 五角星：纯几何源文件链接进来，Fact 验的公式就是插件画图用的那一份 -->
    <Compile Include="..\AcadMgdHost\StarGeometry.fs" Link="StarGeometry.fs" />
    <Compile Include="AcadMgdStarTest.fs" />
    <!-- 一对 Begin/End 事件 → 一个 Task：假事件源离线自检（排在挂回之前，两者各自独立） -->
    <Compile Include="FakeEventPair.fs" />
    <Compile Include="EventPairTest.fs" />
    <!-- AutoCADHost.AutoCADTask（AutoCADTask.fs）：按 PID 挂回 + 命令/LISP 的 Task 入口；真机那条等 EndCommand + LISP 结果文件 -->
    <Compile Include="AcadAttachTest.fs" />
    <!-- PDF 几何图形 → 文字：先把 9 条多段线的顶点转储出来认字，再一次 .lsp 原位写 TEXT -->
    <Compile Include="AcadPdfTextTest.fs" />
    <!-- ExcelHost.ExcelTask.GetApplicationAsync：按 PID 挂回 Excel（Task 版，与 AutoCAD 同口径） -->
    <Compile Include="ExcelAttachTest.fs" />
    <!-- Word / PowerPoint 的挂回闸门：只认 pid，不合格就地拒接（离线） -->
    <Compile Include="AttachGateTest.fs" />
    <!-- 逐页复制升级 .xls：清点 + 真做（只留公式和普通格式） -->
    <Compile Include="XlsPageCopyTest.fs" />
    <!-- OsHost.TextFile：读文本认编码 + 短名称注册的验证 -->
    <Compile Include="TextFileTest.fs" />
    <!-- 热风炉计算书摘要：先只读转储 Excel 计算书，再往用户开着的 Word 里落摘要 -->
    <Compile Include="StoveSummaryTest.fs" />
    <!-- 热风炉报价单：按旭日单结构 + 本项目计算书结果，写进用户开着的「热风炉报价表.xlsx」 -->
    <Compile Include="StoveQuoteTest.fs" />
    <Compile Include="StoveDocTest.fs" />
    <Compile Include="StoveNoXllTest.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="11.0.101" />
    <PackageReference Include="FSharp.xUnit" Version="1.4.1" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OsHost\OsHost.fsproj" />
    <ProjectReference Include="..\AutoCADHost\AutoCADHost.fsproj" />
    <ProjectReference Include="..\WordHost\WordHost.fsproj" />
    <ProjectReference Include="..\ExcelHost\ExcelHost.fsproj" />
    <ProjectReference Include="..\PowerPointHost\PowerPointHost.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 互操作程序集不会沿 ProjectReference 传递：测试项目用强类型成员就得自己引 -->
    <Reference Include="Interop.Word16">
      <HintPath>..\refs\interop16\Interop.Word16.dll</HintPath>
    </Reference>
    <Reference Include="Interop.Excel16">
      <HintPath>..\refs\interop16\Interop.Excel16.dll</HintPath>
    </Reference>
    <Reference Include="Interop.PowerPoint16">
      <HintPath>..\refs\interop16\Interop.PowerPoint16.dll</HintPath>
    </Reference>
    <Reference Include="Interop.Office16">
      <HintPath>..\refs\interop16\Interop.Office16.dll</HintPath>
    </Reference>
    <Reference Include="Autodesk.AutoCAD.Interop">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2020\Autodesk.AutoCAD.Interop.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="Autodesk.AutoCAD.Interop.Common">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2020\Autodesk.AutoCAD.Interop.Common.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Excel 主机（netstandard2.0）：Host.fs 管取/建实例、认人、收尾与一次性命令；ExcelTask.fs 是成品 Task 入口；
    末尾 BookIO.fs + XlsUpgrade.fs（.xls 升级统一入口）。
    有实例取实例，没有就创建一个；不隐藏窗口、不退出，生命周期归调用方。
    互操作程序集随本库一起输出，消费方不必装 Office PIA。
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>ExcelHost</AssemblyName>
    <RootNamespace>ExcelHost</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- 与 OsHost / AutoCADHost / xUnitHost 同为 x64，免得 MSIL 引 AMD64 报 MSB3270 -->
    <PlatformTarget>x64</PlatformTarget>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Host.fs" />
    <!-- 成品 Task 入口单独一份（照 AutoCADTask.fs）：只做闸门 + 排 STA + 抛成 faulted -->
    <Compile Include="ExcelTask.fs" />
    <!-- 末尾：XlsToXlsx / XlsToXlsm / XlsUpgrade 三个入口合在一份文件里；BookIO 是共用 COM 细节 -->
    <Compile Include="BookIO.fs" />
    <Compile Include="XlsUpgrade.fs" />
    <!-- 逐页复制升级：一张一张抄表、在副本里清掉新格式带不走的东西（只留公式和普通格式） -->
    <Compile Include="SheetCopy.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 线程 / 进程账本 / 窗口 → 进程号 / COM 底层都在这一层，三家共用 -->
    <ProjectReference Include="..\OsHost\OsHost.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 互操作程序集：本机 Office 16 类型库生成（强类型，不用晚绑定） -->
    <Reference Include="Interop.Excel16">
      <HintPath>..\refs\interop16\Interop.Excel16.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Interop.Office16">
      <HintPath>..\refs\interop16\Interop.Office16.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="11.0.101" />
  </ItemGroup>

</Project>
